{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "lib": ["ES2023"],
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
  "src/**/*.ts",
  "src/**/*.d.ts",
  "y-websocket.d.ts"
],
  "exclude": ["node_modules", "dist", "/test-db.ts"]
}